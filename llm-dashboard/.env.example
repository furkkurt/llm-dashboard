APP_ENV=dev
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

PROJECT_ROOT=/home/furkan/projects/llm-eval/llm-dashboard
RESULTS_DB=/home/furkan/projects/llm-eval/llm-dashboard/results/results.db
DETEKT_JAR=/home/furkan/projects/llm-eval/llm-dashboard/tools/detekt-cli.jar
# Optional: override bundled Kotlin compiler (default is tools/kotlin from setup.sh / setup.bat)
# KOTLIN_HOME=/home/furkan/projects/llm-eval/llm-dashboard/tools/kotlin
TEMP_RUNS_DIR=/home/furkan/projects/llm-eval/llm-dashboard/temp/runs
RAW_LOGS_DIR=/home/furkan/projects/llm-eval/llm-dashboard/results/raw-logs

# Windows (optional): if Streamlit/Uvicorn was started from a GUI and pub get fails with WinError 2,
# set the Flutter SDK root so the analyzer can find bin/flutter.bat and bundled dart.exe.
# FLUTTER_ROOT=C:\src\flutter
# FLUTTER_HOME=C:\src\flutter
# DART_HOME=C:\src\dart-sdk
# DART_SDK=C:\src\dart-sdk

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter (https://openrouter.ai): AI commentary + "Gemini" generate in UI. Prefer local.env.
# No spaces around = . GET /health/commentary shows env paths.
OPENROUTER_API_KEY=
# Model id from https://openrouter.ai/models (e.g. google/gemini-2.0-flash-001, openai/gpt-4o-mini)
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Optional: default is https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers:
# OPENROUTER_HTTP_REFERER=http://127.0.0.1
# OPENROUTER_APP_TITLE=LLM Eval Dashboard

OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
LLM_REQUEST_TIMEOUT_SEC=120
# OpenRouter commentary on /analyze when auto_commentary=true
COMMENTARY_TIMEOUT_SEC=60
# COMMENTARY_MAX_TOKENS=4096
